<?xml version="1.0"?>
<window><width>1280</width><height>900</height><dialog_on_exit>false</dialog_on_exit></window>
<plugin filename="MinimalScene" name="3D View">
  <ignition-gui><title>Simulation overview</title><property type="string" key="state">docked</property></ignition-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light><background_color>0.8 0.8 0.8</background_color>
  <camera_pose>-1.5 -1.5 1.6 0 0.55 0.70</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <ignition-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></ignition-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="View control">
  <ignition-gui><property type="string" key="state">floating</property><property type="bool" key="showTitleBar">false</property><property type="double" key="width">5</property><property type="double" key="height">5</property></ignition-gui>
</plugin>
<plugin filename="ImageDisplay" name="Right gripper camera">
  <ignition-gui><title>Right gripper camera (GPU sensor)</title><property type="string" key="state">docked</property></ignition-gui>
  <topic>/right_gripper_camera/image_raw</topic>
</plugin>
<plugin filename="WorldStats" name="World stats">
  <ignition-gui><title>Simulation timing</title><property type="string" key="state">docked</property></ignition-gui>
  <sim_time>true</sim_time><real_time>true</real_time><real_time_factor>true</real_time_factor><iterations>true</iterations>
</plugin>
