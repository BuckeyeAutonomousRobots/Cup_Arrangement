COMPOSE_PROJECT_NAME=bar_cup_arrangement
CONTAINER=bar_cup_arrangement_backend
ROS_BASE_IMAGE=ros:humble-ros-base
NOVNC_HOST_PORT=6080
ROS_DOMAIN_ID=41
IGN_PARTITION=bar_cup_arrangement
ROS_TCP_HOST_BIND=127.0.0.1
ROS_TCP_HOST_PORT=10001
ROS_TCP_UNITY_PORT=10001
QUEST_TCP_HOST_BIND=127.0.0.1
QUEST_TCP_HOST_PORT=5026
QUEST_TCP_UNITY_PORT=5026
ENABLE_GPU=0
REDUCED_PROCESS_MODE=1
# Host-specific opt-in; pauses only a separate container named motion_planner_11.
PAUSE_LEGACY_BACKEND=0
# Set ENABLE_GPU=1 on NVIDIA Linux to use docker-compose.gpu.yaml.
# The GPU override enables desktop/noVNC independently of the EGL server.
ENABLE_GRIPPER_CAMERA=1
ENABLE_DESKTOP=0
ENABLE_NOVNC=0
SIM_HEADLESS=1
