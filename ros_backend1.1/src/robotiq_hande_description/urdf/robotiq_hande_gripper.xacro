<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    Original URDF file by Cristian C Beltran-Hernandez
  -->

  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande_gripper.ros2_control.xacro"/>
  <xacro:include filename="$(find robotiq_hande_description)/urdf/cylinder_inertial.xacro"/>

  <xacro:macro
    name="robotiq_hande_gripper"
    params="name
            prefix
            parent
            grip_pos_min
            grip_pos_max
            tty_port
            baudrate
            parity
            data_bits
            stop_bit
            slave_id
            use_fake_hardware
            sim_gazebo:=false
            sim_ignition:=false
            frequency_hz:=10
            create_socat_tty:=false
            socat_ip_address:=127.0.0.1
            socat_port:=54321
            coupler_mass:=0.119
            generate_ros2_control_tag:=true
            xyz:='0 0 0'
            rpy:='0 0 0'"
  >
    <!-- ros2_control parameters  -->
    <xacro:if value="${generate_ros2_control_tag}">
      <xacro:robotiq_hande_ros2_control
        name="${name}"
        prefix="${prefix}"
        grip_pos_min="${grip_pos_min}"
        grip_pos_max="${grip_pos_max}"
        tty_port="${tty_port}"
        baudrate="${baudrate}"
        parity="${parity}"
        data_bits="${data_bits}"
        stop_bit="${stop_bit}"
        slave_id="${slave_id}"
        frequency_hz="${frequency_hz}"
        create_socat_tty="${create_socat_tty}"
        socat_ip_address="${socat_ip_address}"
        socat_port="${socat_port}"
        use_fake_hardware="${use_fake_hardware}"
        sim_gazebo="${sim_gazebo}"
        sim_ignition="${sim_ignition}"
      />
    </xacro:if>

    <!-- Robotiq Hand-E specs -->
    <!--  + Height added by the IO coupler: 11.0mm -->
    <!--  + Height added by the Hand-E: 99.0mm -->
    <!--  + Coupler mass includes the bolts -->
    <xacro:property name="finger_origin_shift" value="${0.025 if (sim_gazebo or sim_ignition) else 0.0}"/>

    <xacro:arg name="coupler_height" default="0.011"/>
    <xacro:arg name="coupler_shell_height" default="0.0169"/>
    <xacro:arg name="coupler_parent_cutoff" default="0.003"/>
    <xacro:arg name="coupler_hande_cutoff" default="0.0029"/>
    <xacro:arg name="hande_height" default="0.099"/>
    <xacro:arg name="hande_radius" default="0.0375"/>

    <joint name="${prefix}robotiq_hande_coupler_joint" type="fixed">
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <parent link="${parent}"/>
      <child link="${prefix}robotiq_hande_coupler"/>
    </joint>

    <link name="${prefix}robotiq_hande_coupler">
      <visual>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/io_coupler.dae"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 ${$(arg coupler_shell_height)/2 - $(arg coupler_parent_cutoff)}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="$(arg coupler_shell_height)" radius="${$(arg hande_radius) + 0.001}"/>
        </geometry>
      </collision>

      <xacro:__robotiq_hande_cylinder_inertial radius="$(arg hande_radius)" height="$(arg coupler_shell_height)" mass="${coupler_mass}">
        <origin xyz="0 0 ${$(arg coupler_shell_height) / 2 - $(arg coupler_parent_cutoff)}" rpy="0 0 0"/>
      </xacro:__robotiq_hande_cylinder_inertial>
    </link>

    <joint name="${prefix}robotiq_hande_base_joint" type="fixed">
      <origin xyz="0 0 $(arg coupler_height)" rpy="0 0 0"/>
      <parent link="${prefix}robotiq_hande_coupler"/>
      <child link="${prefix}robotiq_hande_link"/>
    </joint>

    <link name="${prefix}robotiq_hande_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/hande.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 ${($(arg hande_height) + $(arg coupler_hande_cutoff) + 0.005) / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="${$(arg hande_height) + $(arg coupler_hande_cutoff) + 0.005}" radius="${$(arg hande_radius) + 0.001}"/>
        </geometry>
      </collision>

      <xacro:__robotiq_hande_cylinder_inertial radius="$(arg hande_radius)" height="$(arg hande_height)" mass="0.86387">
        <origin xyz="0 0 ${$(arg hande_height) / 2}" rpy="0 0 0"/>
      </xacro:__robotiq_hande_cylinder_inertial>
    </link>

    <joint name="${prefix}robotiq_hande_left_finger_joint" type="prismatic">
      <origin xyz="${-finger_origin_shift} 0 $(arg hande_height)" rpy="0 0 0"/>
      <parent link="${prefix}robotiq_hande_link"/>
      <child link="${prefix}robotiq_hande_left_finger"/>
      <axis xyz="-1 0 0"/>
      <limit effort="500" lower="${grip_pos_min}" upper="${grip_pos_max}" velocity="0.15"/>
      <dynamics damping="0.02" friction="0.0"/>
    </joint>

    <link name="${prefix}robotiq_hande_left_finger">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/finger.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>

      <collision>
        <!-- Use a small fingertip box. Offset it outward so the two fingers do not overlap and jam at q=0. -->
        <origin xyz="-0.006 0 0.032" rpy="0 0 0"/>
        <geometry>
          <box size="0.008 0.018 0.042"/>
        </geometry>
      </collision>

      <inertial>
        <!-- Uniform-box estimate matching the collision proxy; avoids the
             nearly singular placeholder inertia during contact. -->
        <origin xyz="-0.006 0 0.032" rpy="0 0 0"/>
        <mass value="0.03804"/>
        <inertia ixx="${0.03804 * (0.018**2 + 0.042**2) / 12}" ixy="0.0" ixz="0.0" iyy="${0.03804 * (0.008**2 + 0.042**2) / 12}" iyz="0.0" izz="${0.03804 * (0.008**2 + 0.018**2) / 12}"/>
      </inertial>
    </link>

    <joint name="${prefix}robotiq_hande_right_finger_joint" type="prismatic">
      <origin xyz="${finger_origin_shift} 0 $(arg hande_height)" rpy="0 0 0"/>
      <parent link="${prefix}robotiq_hande_link"/>
      <child link="${prefix}robotiq_hande_right_finger"/>
      <axis xyz="1 0 0"/>
      <limit effort="500" lower="${grip_pos_min}" upper="${grip_pos_max}" velocity="0.15"/>
      <dynamics damping="0.02" friction="0.0"/>
      <xacro:unless value="${sim_gazebo or sim_ignition}">
        <mimic joint="${prefix}robotiq_hande_left_finger_joint" multiplier="1" offset="0"/>
      </xacro:unless>
    </joint>

    <link name="${prefix}robotiq_hande_right_finger">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/finger.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </visual>

      <collision>
        <!-- Use a small fingertip box. Offset it outward so the two fingers do not overlap and jam at q=0. -->
        <origin xyz="0.006 0 0.032" rpy="0 0 0"/>
        <geometry>
          <box size="0.008 0.018 0.042"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0.006 0 0.032" rpy="0 0 0"/>
        <mass value="0.03804"/>
        <inertia ixx="${0.03804 * (0.018**2 + 0.042**2) / 12}" ixy="0.0" ixz="0.0" iyy="${0.03804 * (0.008**2 + 0.042**2) / 12}" iyz="0.0" izz="${0.03804 * (0.008**2 + 0.018**2) / 12}"/>
      </inertial>
    </link>

    <joint name="${prefix}robotiq_hande_end_joint" type="fixed">
      <origin xyz="0 0 ${$(arg hande_height) + 0.0465}" rpy="0 0 0"/>
      <parent link="${prefix}robotiq_hande_link"/>
      <child link="${prefix}robotiq_hande_end"/>
    </joint>

    <link name="${prefix}robotiq_hande_end"/>
  </xacro:macro>
</robot>
