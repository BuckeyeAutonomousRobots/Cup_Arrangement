# Copy to .hosting.env at the repository root. No shell code is evaluated.
CAPSTONE_MODE=local
CAPSTONE_GPU=0
CAPSTONE_VIEWER=0
CAPSTONE_VIEWER_PORT=6080
CAPSTONE_ROS_DOMAIN_ID=41
CAPSTONE_PROJECT=bar_cup_arrangement
CAPSTONE_CONTAINER=bar_cup_arrangement_backend

# Optional remote/cloud Linux host. Fill only when selecting remote mode.
CAPSTONE_REMOTE_HOST=
CAPSTONE_REMOTE_WORKSPACE=
# Example values after you provision/authorize a host yourself:
# CAPSTONE_MODE=remote
# CAPSTONE_REMOTE_HOST=user@YOUR_HOST
# CAPSTONE_REMOTE_WORKSPACE=/path/to/Cup_Arrangement
